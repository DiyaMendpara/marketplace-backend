# Server
PORT=4000
CLIENT_URL=http://localhost:3000

# Database — local dev uses a separate DB name from Loadrive on the same server.
# In production (Render) set this to your Atlas SRV string ending in /marketplace.
MONGODB_URI=mongodb://127.0.0.1:27017/marketplace

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=7d
SALT_ROUNDS=10

# Super admin seeded on first boot (roles are seeded automatically)
SUPER_ADMIN_EMAIL=admin@loomly.com
SUPER_ADMIN_PASSWORD=Admin@123

# Google Sign-In (OAuth Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
